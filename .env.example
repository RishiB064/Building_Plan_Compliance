# Copy to .env and fill in. Nothing here is committed with real values (D4).

# --- LLM provider (any OpenAI-compatible /chat/completions endpoint) ---
# Real run: your provider's base URL, key and model. Load test / offline: point at the stub.
LLM_BASE_URL=http://llm-stub:8080/v1
LLM_API_KEY=change-me
LLM_MODEL=stub-model
LLM_TIMEOUT_S=30
# Real providers only: ask for JSON replies and short reasoning (leave empty for the stub)
LLM_JSON_MODE=
LLM_REASONING_EFFORT=
# Free tiers: on a rate-limit reply wait as told (seconds, per wait) and allow longer runs
LLM_RATE_LIMIT_WAIT_S=0
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=0.5
BREAKER_FAIL_THRESHOLD=4
BREAKER_RESET_S=20
PRICE_PROMPT_PER_1K=0.0
PRICE_COMPLETION_PER_1K=0.0

# --- Stub behaviour (only used by the llm-stub service) ---
STUB_DELAY_MS=1500

# --- Embeddings (local, free) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Infra ---
REDIS_URL=redis://redis:6379/0
CORPUS_DIR=/data/corpus
INDEX_DIR=/data/index
PROMPTS_DIR=/app/prompts
PROMPT_VERSION=v1

# --- Agent limits (A1) ---
MAX_STEPS=14
MAX_TOOL_CALLS=14
MAX_RUN_SECONDS=90
MAX_VERIFY_ATTEMPTS=2
MIN_RELEVANCE=0.25

# --- Service limits (D7) ---
RATE_LIMIT_PER_MIN=10
WORKER_CONCURRENCY=1          # runs per worker process (threads); the model call is the slow part
SCORE_SAMPLE_RATE=0.25        # share of finished runs scored automatically (L6)
RUN_CACHE_TTL_S=3600
API_ALLOWED_CLIENT_HEADER=X-Client-Id
